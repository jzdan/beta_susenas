# Contoh konfigurasi PRODUKSI Sistem SUSENAS.
# Salin ke .env di server, isi nilai rahasia, JANGAN commit .env.
# Setelah mengisi: php artisan key:generate --force && php artisan config:cache

APP_NAME="Sistem SUSENAS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://susenas.internal.bps.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# --- Database: pilih mysql ATAU pgsql ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=susenas
DB_USERNAME=susenas
DB_PASSWORD=

# (alternatif MySQL 8.0.13+)
# DB_CONNECTION=mysql
# DB_PORT=3306
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- Sesi & cache: pakai database (sudah termigrasi) atau redis ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Jika Redis tersedia:
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

# --- Log ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Di belakang reverse proxy (nginx/HAProxy) yang terminasi TLS ---
# Isi dengan CIDR proxy internal, mis. 10.0.0.0/8
TRUSTED_PROXIES=

# --- Email (opsional; untuk notifikasi) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="susenas-noreply@bps.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# SSO BPS / Keycloak — belum diaktifkan (login lokal). Lihat docs/deployment.md.
